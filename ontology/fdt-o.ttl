    skos:historyNote "Retired in FDT-O v2 (12 Sep 2026): the term namespace was unified on https://w3id.org/fdt#, which the shapes and example instances already used. This IRI is kept as an equivalence bridge so prototype data keeps its meaning."@en .

fdt-o-legacy:payloadContent a owl:DatatypeProperty ;
    rdfs:seeAlso fdt-o:payloadContent ;
    owl:deprecated true ;
    owl:equivalentProperty fdt-o:payloadContent ;
    skos:historyNote "Retired in FDT-O v2 (12 Sep 2026): the term namespace was unified on https://w3id.org/fdt#, which the shapes and example instances already used. This IRI is kept as an equivalence bridge so prototype data keeps its meaning."@en .

fdt-o-legacy:payloadDownloadURL a owl:ObjectProperty ;
    rdfs:seeAlso fdt-o:payloadDownloadURL ;
    owl:deprecated true ;
    owl:equivalentProperty fdt-o:payloadDownloadURL ;
    skos:historyNote "Retired in FDT-O v2 (12 Sep 2026): the term namespace was unified on https://w3id.org/fdt#, which the shapes and example instances already used. This IRI is kept as an equivalence bridge so prototype data keeps its meaning."@en .

fdt-o-legacy:payloadMediaType a owl:DatatypeProperty ;
    rdfs:seeAlso fdt-o:payloadMediaType ;
    owl:deprecated true ;
    owl:equivalentProperty fdt-o:payloadMediaType ;
    skos:historyNote "Retired in FDT-O v2 (12 Sep 2026): the term namespace was unified on https://w3id.org/fdt#, which the shapes and example instances already used. This IRI is kept as an equivalence bridge so prototype data keeps its meaning."@en .

fdt-o-legacy:startDate a owl:DatatypeProperty ;
    rdfs:seeAlso fdt-o:startDate ;
    owl:deprecated true ;
    owl:equivalentProperty fdt-o:startDate ;
    skos:historyNote "Retired in FDT-O v2 (12 Sep 2026): the term namespace was unified on https://w3id.org/fdt#, which the shapes and example instances already used. This IRI is kept as an equivalence bridge so prototype data keeps its meaning."@en .

fdt-o-legacy:supportsInteractionMechanism a owl:ObjectProperty ;
    rdfs:seeAlso fdt-o:supportsInteractionMechanism ;
    owl:deprecated true ;
    owl:equivalentProperty fdt-o:supportsInteractionMechanism ;
    skos:historyNote "Retired in FDT-O v2 (12 Sep 2026): the term namespace was unified on https://w3id.org/fdt#, which the shapes and example instances already used. This IRI is kept as an equivalence bridge so prototype data keeps its meaning."@en .

fdt-inst:API a owl:NamedIndividual,
        fdt-o:API .

fdt-inst:Docker a owl:NamedIndividual,
        fdt-o:Docker .

fdt-inst:ExecutableContainer a owl:NamedIndividual,
        fdt-o:ExecutableContainer .

fdt-inst:FHIRAPI a owl:NamedIndividual,
        fdt-o:FHIRAPI .

fdt-inst:GraphQL a owl:NamedIndividual,
        fdt-o:GraphQL .

fdt-inst:IdentifierTranslation a owl:NamedIndividual,
        fdt-o:IdentifierTranslation ;
    rdfs:label "identifier translation"@en ;
    skos:definition "Interaction mechanism of a LinkageStation: translate a set of pseudonyms from one pseudonym space into another."@en .

fdt-inst:Python a owl:NamedIndividual,
        fdt-o:Python .

fdt-inst:Query a owl:NamedIndividual,
        fdt-o:Query .

fdt-inst:R a owl:NamedIndividual,
        fdt-o:R .

fdt-inst:RESTAPI a owl:NamedIndividual,
        fdt-o:RESTAPI .

fdt-inst:SPARQL a owl:NamedIndividual,
        fdt-o:SPARQL .

fdt-inst:SQL a owl:NamedIndividual,
        fdt-o:SQL .

fdt-inst:Script a owl:NamedIndividual,
        fdt-o:Script .

fdt-inst:Singularity a owl:NamedIndividual,
        fdt-o:Singularity .

fdt-inst:TPF a owl:NamedIndividual,
        fdt-o:TPF .

fdt-inst:VocabularyAlignment a owl:NamedIndividual,
        fdt-o:VocabularyAlignment ;
    rdfs:label "vocabulary alignment"@en ;
    skos:definition "Interaction mechanism of an AlignmentStation: map codes, terms or units between vocabularies."@en .

<http://purl.obolibrary.org/obo/BFO_0000051> a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:subPropertyOf owl:topObjectProperty .

dct:creator a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:domain dcat:Resource ;
    rdfs:range foaf:Agent ;
    rdfs:subPropertyOf owl:topObjectProperty .

<https://github.com/kburger> a owl:NamedIndividual ;
    rdfs:label "Kees Burger"^^xsd:string .

<https://github.com/luizbonino> a owl:NamedIndividual ;
    rdfs:label "Luiz Olavo Bonino da Silva Santos"^^xsd:string .

<https://github.com/rajaram5> a owl:NamedIndividual ;
    rdfs:label "Rajaram Kaliyaperumal"^^xsd:string .

fdp-o:FAIRDataPoint a owl:Class ;
    rdfs:subClassOf fdp-o:MetadataService .

fdp-o:MetadataService a owl:Class ;
    rdfs:subClassOf dcat:DataService .

fdt-o:IdentifierTranslation a owl:Class ;
    rdfs:label "Identifier translation"@en ;
    rdfs:subClassOf fdt-o:InteractionMechanism ;
    skos:definition "Translation of pseudonymous identifiers between two pseudonym spaces, the only mechanism a linkage station offers (ADR-022)."@en .

fdt-o:LinkageStation a owl:Class ;
    rdfs:label "linkage station"@en ;
    rdfs:subClassOf fdt-o:DataStation ;
    skos:definition "A Data Station whose interaction mechanism is identifier translation between organisational pseudonym spaces; visited as a hop under its own agreement; may wrap an existing trusted third party (ADR-022)."@en .

fdt-o:VocabularyAlignment a owl:Class ;
    rdfs:label "Vocabulary alignment"@en ;
    rdfs:subClassOf fdt-o:InteractionMechanism ;
    skos:definition "Alignment of coding systems or vocabularies across stations (ADR-024)."@en .

dct:date a owl:DatatypeProperty ;
    rdfs:subPropertyOf owl:topDataProperty .

dcat:DataService a owl:Class ;
    rdfs:subClassOf dcat:Resource .

fdt-o:ComputationalEnvironmentRequirement a owl:Class ;
    rdfs:label "Computational Environment Requirement"@en ;
    rdfs:subClassOf fdt-o:TrainRequirement .

fdt-o:DockerTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:Docker ],
        fdt-o:ContainerTrain ;
    owl:disjointWith fdt-o:SingularityTrain .

fdt-o:FHIRTrain a owl:Class ;
    rdfs:label "FHIR Train"@en ;
    dct:description "The FHIRTrain is a specialisation of the RESTTrain which is constraint to the resource types and respective parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:FHIRAPI ],
        fdt-o:RESTTrain .

fdt-o:GraphQLTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:GraphQL ],
        fdt-o:QueryTrain .

fdt-o:InputRequirement a owl:Class ;
    rdfs:label "Input Requirement"@en ;
    rdfs:subClassOf fdt-o:TrainRequirement .

fdt-o:JoinKey a owl:Class ;
    rdfs:label "join key"@en ;
    skos:definition "A key space datasets can be joined on: a pseudonym space, a spatial or administrative unit, a time axis (ADR-024)."@en .

fdt-o:PythonTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:Python ],
        fdt-o:ScriptTrain ;
    owl:disjointWith fdt-o:RTrain .

fdt-o:StationOwner a owl:Class ;
    dct:description "Station Owner represents the Agent(s) (organization or person) who is(are) responsible for the operations of the Data Station."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:hasControllingRights ;
            owl:someValuesFrom fdt-o:DataStation ],
        foaf:Agent .

fdt-o:TrainOwner a owl:Class ;
    dct:description "Train Owner represents the agent(s) (organization or person) who sent a Train to a Data Station. Therefore, the Train is visiting a Station on behalf of the Train Owner."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:hasControllingRights ;
            owl:someValuesFrom fdt-o:Train ],
        foaf:Agent .

fdt-o:TrainProvider a owl:Class ;
    dct:description "Train Provider represents the agent(s) (organization or person) who created the Train."@en ;
    rdfs:subClassOf foaf:Agent .

fdt-o:endDate a owl:DatatypeProperty ;
    rdfs:domain fdt-o:DataStation ;
    rdfs:range xsd:dateTime,
        xsd:dateTimeStamp ;
    rdfs:subPropertyOf dct:date ;
    owl:propertyDisjointWith fdt-o:startDate .

fdt-o:hasPayload a owl:ObjectProperty ;
    rdfs:label "has payload" ;
    rdfs:comment "Relation which links computational artifacts to its payload" ;
    rdfs:domain fdt-o:Train ;
    rdfs:range fdt-o:Payload ;
    owl:inverseOf fdt-o:isPayloadOf ;
    skos:scopeNote "The train's executable artefact. Replaces any use of dcat:distribution on trains (dcat:distribution has domain dcat:Dataset)."@en .

fdt-o:hasTrainType a owl:ObjectProperty ;
    rdfs:domain fdt-o:Train ;
    rdfs:subPropertyOf owl:topObjectProperty .

fdt-o:payloadContent a owl:DatatypeProperty ;
    rdfs:domain fdt-o:Payload ;
    rdfs:range xsd:string .

fdt-o:payloadDownloadURL a owl:ObjectProperty ;
    rdfs:label "payload download url" ;
    rdfs:comment "Downloadable location of payload" ;
    rdfs:domain fdt-o:Payload .

fdt-o:payloadMediaType a owl:DatatypeProperty ;
    rdfs:domain fdt-o:Payload ;
    rdfs:range xsd:string .

fdt-o:APITrain a owl:Class ;
    rdfs:label "API Train"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:API ],
        fdt-o:Train .

fdt-o:ComputationalArtifact a owl:Class ;
    rdfs:label "Computational Artifact"@en ;
    rdfs:subClassOf dcat:Resource .

fdt-o:DataController a owl:Class ;
    rdfs:label "data controller"@en ;
    dct:description "Data Controller represents the Agent(s) (organization or person) who has controlling rights over datasets. Among these controlling rights we may have the right to modify, delete data, define the access conditions or consent access, among others."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:hasControllingRights ;
            owl:someValuesFrom dcat:Dataset ],
        foaf:Agent ;
    skos:definition "The party that decides the conditions under which a hosted dataset may be used and approves agreements over it — an organisation or a natural person (ADR-011). Distinct from the StationOwner, who operates the station, and from the TrainOwner."@en .

fdt-o:HostedDataset a owl:Class ;
    rdfs:label "hosted dataset"@en ;
    rdfs:subClassOf dcat:Dataset ;
    skos:definition "A dataset hosted by a Data Station and governed by its data controller's offers. Distinguished from the dcat:Dataset descriptions a train uses for its declared inputs and outputs (fdt-o:hasRequirement / fdt-o:generatesOutput), which are descriptions of expected data, not hosted data."@en .

fdt-o:RESTTrain a owl:Class ;
    rdfs:label "REST Train"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:RESTAPI ],
        fdt-o:APITrain .

fdt-o:RTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:R ],
        fdt-o:ScriptTrain .

fdt-o:SPARQLTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:SPARQL ],
        fdt-o:QueryTrain .

fdt-o:SQLTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:SQL ],
        fdt-o:QueryTrain .

fdt-o:SingularityTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:Singularity ],
        fdt-o:ContainerTrain .

fdt-o:TriplePatternFragmentTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:TPF ],
        fdt-o:QueryTrain .

fdt-o:generatesOutput a owl:ObjectProperty ;
    rdfs:domain fdt-o:Train ;
    rdfs:range dcat:Dataset ;
    rdfs:subPropertyOf owl:topObjectProperty .

fdt-o:hasRequirement a owl:ObjectProperty ;
    rdfs:label "has requirement"@en ;
    rdfs:subPropertyOf owl:topObjectProperty .

fdt-o:isControlledBy a owl:ObjectProperty ;
    dct:description "This relation represents the relation in which a resource is controlled by an agent."@en ;
    rdfs:domain dcat:Resource ;
    rdfs:range foaf:Agent .

fdt-o:isPayloadOf a owl:ObjectProperty ;
    rdfs:domain fdt-o:Payload ;
    rdfs:range fdt-o:Train ;
    rdfs:subPropertyOf owl:topObjectProperty .

fdt-o:startDate a owl:DatatypeProperty ;
    rdfs:subPropertyOf dct:date .

fdt-o:supportsInteractionMechanism a owl:ObjectProperty ;
    rdfs:domain fdt-o:DataStation ;
    rdfs:range fdt-o:InteractionMechanism ;
    rdfs:subPropertyOf owl:topObjectProperty .

fdt-o:ContainerTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:ExecutableContainer ],
        fdt-o:Train .

fdt-o:Docker a owl:Class ;
    rdfs:label "Docker Container"@en ;
    rdfs:subClassOf fdt-o:ExecutableContainer .

fdt-o:FHIRAPI a owl:Class ;
    rdfs:label "FHIR API"@en ;
    rdfs:comment "The FHIR API is a specialisation of the REST API interaction mechanism in which the station only accept call to resources and respective parameters that are part of the FHIR specifications."@en ;
    rdfs:subClassOf fdt-o:RESTAPI .

fdt-o:GraphQL a owl:Class ;
    rdfs:label "GraphQL"@en ;
    rdfs:subClassOf fdt-o:Query .

fdt-o:Python a owl:Class ;
    rdfs:subClassOf fdt-o:Script .

fdt-o:R a owl:Class ;
    rdfs:subClassOf fdt-o:Script .

fdt-o:SPARQL a owl:Class ;
    rdfs:label "SPARQL"@en ;
    rdfs:subClassOf fdt-o:Query .

fdt-o:SQL a owl:Class ;
    rdfs:label "SQL"@en ;
    rdfs:subClassOf fdt-o:Query .

fdt-o:ScriptTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:Script ],
        fdt-o:Train .

fdt-o:Singularity a owl:Class ;
    rdfs:label "Singularity Container"@en ;
    rdfs:subClassOf fdt-o:ExecutableContainer .

fdt-o:TPF a owl:Class ;
    rdfs:label "Triple Pattern Fragments"@en ;
    rdfs:subClassOf fdt-o:Query .

dcat:Dataset a owl:Class ;
    rdfs:subClassOf dcat:Resource .

fdt-o:API a owl:Class ;
    rdfs:subClassOf fdt-o:InteractionMechanism .

fdt-o:RESTAPI a owl:Class ;
    rdfs:label "REST API"@en ;
    rdfs:subClassOf fdt-o:API .

fdt-o:TrainRequirement a owl:Class ;
    rdfs:label "Train Requirement"@en .

fdt-o:hasControllingRights a owl:ObjectProperty ;
    dct:description "This property represents the relation when an Agent has controlling rights over resources (data, services, etc.)."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range dcat:Resource ;
    owl:inverseOf fdt-o:isControlledBy .

fdt-o:ExecutableContainer a owl:Class ;
    rdfs:subClassOf fdt-o:InteractionMechanism .

fdt-o:QueryTrain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:Query ],
        fdt-o:Train .

fdt-o:Script a owl:Class ;
    rdfs:subClassOf fdt-o:InteractionMechanism .

dcat:Resource a owl:Class .

foaf:Agent a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dct:creator ;
            owl:someValuesFrom fdt-o:Train ] .

fdt-o:DataStation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:supportsInteractionMechanism ;
            owl:someValuesFrom fdt-o:InteractionMechanism ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
            owl:someValuesFrom fdp-o:FAIRDataPoint ],
        dcat:DataService .

fdt-o:Payload a owl:Class ;
    rdfs:comment "Payload",
        "Actually payload of the Train, e.g. query string, script, docker image identifier, API call."@en ;
    rdfs:subClassOf dcat:Resource .

fdt-o:Query a owl:Class ;
    rdfs:subClassOf fdt-o:InteractionMechanism .

fdt-o:InteractionMechanism a owl:Class .

fdt-o:Train a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty fdt-o:implementsInteractionMechanism ;
            owl:someValuesFrom fdt-o:InteractionMechanism ],
        [ a owl:Restriction ;
            owl:onProperty fdt-o:generatesOutput ;
            owl:someValuesFrom dcat:Dataset ],
        [ a owl:Restriction ;
            owl:onProperty fdt-o:hasRequirement ;
            owl:someValuesFrom fdt-o:TrainRequirement ],
        dcat:Resource,
        odrl:Asset,
        fdt-o:ComputationalArtifact ;
    owl:disjointWith dcat:Dataset ;
    skos:scopeNote "A train is an executable interaction (query, API call, script, container) packaged with its description. It is an ODRL asset and a DCAT resource; it is never a dcat:Dataset and never has a dcat:distribution — its artefact is its fdt-o:hasPayload (decision of 11 September 2026)."@en .

fdt-o:implementsInteractionMechanism a owl:ObjectProperty ;
    rdfs:domain fdt-o:Train ;
    rdfs:range fdt-o:InteractionMechanism ;
    rdfs:subPropertyOf owl:topObjectProperty .

[] a owl:AllDisjointClasses ;
    owl:members ( fdt-o:SPARQLTrain fdt-o:SQLTrain fdt-o:TriplePatternFragmentTrain ) .

