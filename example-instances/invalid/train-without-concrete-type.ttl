@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/>.
@prefix fdt-o: <https://w3id.org/fdt/fdt-o#>.
@prefix fdt-inst: <https://w3id.org/fdt/instances#>.
@prefix : <http://example.com/trains/invalid/>.

# INVALID: fdt-o:Train and odrl:Asset only — no concrete train family; and no payload.
:vague-train a fdt-o:Train, odrl:Asset;
  dcterms:title "Train without a concrete type or payload";
  fdt-o:implementsInteractionMechanism fdt-inst:SPARQL;
  fdt-o:generatesOutput :out;
  dcat:theme <http://example.com/theme>.
