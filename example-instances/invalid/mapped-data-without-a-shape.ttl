@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix fdt-o: <https://w3id.org/fdt/fdt-o#>.
@prefix : <http://example.com/parts/invalid/>.

# INVALID (FDT-O v4, ADR-030): a mapping published without the shape it generates, and a
# mapping nobody can fetch.
#
# The mapping says how the station's source becomes RDF. The shape says what the result looks
# like. Matching needs the second one; publishing only the first looks like openness and gives
# a registry nothing to index. And a mapping with no dcat:accessURL cannot be checked against
# the shape it supposedly generated, which is the only reason to publish a mapping at all.

:mapped a dcat:Dataset, fdt-o:HostedDataset;
  dcterms:title "Relational registry extract, mapped but undescribed";
  fdt-o:hasDataController :controller;
  fdt-o:mappedBy :mapping.

:mapping a fdt-o:RMLMapping;
  dcterms:title "RML mapping nobody can fetch".

:controller a fdt-o:DataController, foaf:Organization;
  foaf:name "Exemplar controller (fictional)".
