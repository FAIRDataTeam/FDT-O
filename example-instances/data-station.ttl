@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix fdt-o: <https://w3id.org/fdt/fdt-o#>.
@prefix fdt-inst: <https://w3id.org/fdt/instances#>.
@prefix fdp-o: <https://w3id.org/fdp/fdp-o#>.
@prefix : <http://example.com/datastation/>.

:data-station a fdt-o:DataStation;
  dcterms:title "An exemplar data station";
  fdt-o:isControlledBy [a fdt-o:StationOwner;
      foaf:name "Rajaram Kaliyaperumal"];
  fdt-o:supportsInteractionMechanism fdt-inst:SPARQL;
  fdt-o:supportsInteractionMechanism fdt-inst:RESTAPI;
  fdp-o:hasMetadata :data-station-metadata;
  fdt-o:hostsDataset :covid-cases-nl;            # v2: hosted dataset (fdt-o:HostedDataset)
  fdt-o:publishesCatalog :catalog;                # v2: the station catalogue
  dcterms:description """An exemplar data station which contents COVID 19 data. This station supports SPARQL interaction mechanism""".


:data-station-metadata a fdp-o:MetadataRecord;
  dcterms:title "Metadata of data station";
  dcterms:publisher [ a foaf:Agent;
      foaf:name "Rajaram Kaliyaperumal"
  ];
  dcterms:hasVersion "1.0";
  fdp-o:isMetadataOf :data-station;
  dcterms:license <https://creativecommons.org/licenses/by/4.0>.

# --- v2 additions -----------------------------------------------------------------------
:catalog a dcat:Catalog, fdt-o:StationCatalog;
  dcterms:title "Catalogue of the exemplar data station";
  dcterms:publisher :data-station;
  dcat:dataset :covid-cases-nl.

:covid-cases-nl a dcat:Dataset, fdt-o:HostedDataset;
  dcterms:title "COVID-19 cases per municipality (NL)";
  fdt-o:hasDataController :controller;             # ADR-011: the controller, distinct from the station owner
  fdt-o:joinKey :municipality-code.

:controller a fdt-o:DataController, foaf:Organization;
  foaf:name "Exemplar public-health institute".

:municipality-code a fdt-o:JoinKey;
  dcterms:title "Municipality code (CBS)".
